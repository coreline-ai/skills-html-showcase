{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://meewang.kr/skills/adaptive-html-final/schemas/quality-report.schema.json",
  "title": "Quality Report",
  "type": "object",
  "required": [
    "mode",
    "layout",
    "rubric",
    "total",
    "verdict",
    "gates",
    "notes"
  ],
  "properties": {
    "mode": {
      "type": "string"
    },
    "layout": {
      "type": "string"
    },
    "rubric": {
      "type": "object",
      "description": "references/eval-rubric.md의 7개 항목별 0~5 정수 정성 점수 (만점 35)",
      "required": [
        "mode_fit",
        "layout_fit",
        "design_dna",
        "content_depth",
        "seo_a11y",
        "factuality",
        "source_handling"
      ],
      "properties": {
        "mode_fit": {
          "$ref": "#/$defs/rubricScore"
        },
        "layout_fit": {
          "$ref": "#/$defs/rubricScore"
        },
        "design_dna": {
          "$ref": "#/$defs/rubricScore"
        },
        "content_depth": {
          "$ref": "#/$defs/rubricScore"
        },
        "seo_a11y": {
          "$ref": "#/$defs/rubricScore"
        },
        "factuality": {
          "$ref": "#/$defs/rubricScore"
        },
        "source_handling": {
          "$ref": "#/$defs/rubricScore"
        }
      },
      "additionalProperties": false
    },
    "total": {
      "type": "integer",
      "description": "rubric 7개 항목 score의 합계, 0~35 (만점 35). references/eval-rubric.md 기준: 28 이상 pass, 24~27 revise, 23 이하 fail",
      "minimum": 0,
      "maximum": 35
    },
    "verdict": {
      "type": "string",
      "enum": [
        "pass",
        "revise",
        "fail"
      ]
    },
    "gates": {
      "type": "object",
      "description": "출시 게이트 통과 여부",
      "additionalProperties": {
        "type": "boolean"
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "rubricScore": {
      "type": "object",
      "required": [
        "score"
      ],
      "properties": {
        "score": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5
        },
        "comment": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  }
}
