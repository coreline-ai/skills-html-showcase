    "{{TITLE}}",
    "{{SUBTITLE}}",
    "{{META}}",
    "{{PRIMARY_KEYWORD}}",
    "{{SERP_PREVIEW}}",
    "{{TITLE_CANDIDATES}}",
    "{{META_CANDIDATES}}",
    "{{TAG_CLUSTER}}",
    "{{CONTENT_OUTLINE}}",
    "{{FINAL_SEO_SET}}",
    "{{SOURCE_NOTE}}"
  ],
  "primary_vt": "card-grid",
  "vt_candidates": [
    "card-grid",
    "comparison-cards",
    "prompt-tuner"
  ],
  "vt_markers": [
    "\\bcg-grid\\b"
  ],
  "wg_candidates": [
    "wg-11"
  ],
  "wg_markers": [
    "wg-11-"
  ],
  "toc_contract": {
    "rule": "structural_h2_gte_4",
    "required_class": null,
